+// Android's recent-apps chooser understands Alt+Tab and Shift+Alt+Tab.
+// Keep the synthetic Android Alt pressed while PC Ctrl is held.
+static bool
+send_recent_apps_key(struct sc_input_manager *im,
+                     enum android_keycode keycode, enum sc_action action,
+                     uint32_t metastate) {
+    struct sc_control_msg msg;
+    msg.type = SC_CONTROL_MSG_TYPE_INJECT_KEYCODE;
+    msg.inject_keycode.action = action == SC_ACTION_DOWN
+                              ? AKEY_EVENT_ACTION_DOWN
+                              : AKEY_EVENT_ACTION_UP;
+    msg.inject_keycode.keycode = keycode;
+    msg.inject_keycode.metastate = metastate;
+    msg.inject_keycode.repeat = 0;
+    if (!sc_controller_push_msg(im->controller, &msg)) {
+        LOGW("Could not inject Android recent-apps key");
+        return false;
+    }
+    return true;
+}
+
+static void
+release_recent_apps_alt(struct sc_input_manager *im) {
+    if (im->android_alt_down) {
+        send_recent_apps_key(im, AKEYCODE_ALT_LEFT, SC_ACTION_UP, 0);
+        im->android_alt_down = false;
+    }
+}
+
 static inline void
 action_home(struct sc_input_manager *im, enum sc_action action) {
     send_keycode(im, AKEYCODE_HOME, action, "HOME");
@@ -219,6 +252,8 @@ set_display_power(struct sc_input_manager *im, bool on) {
 
     if (!sc_controller_push_msg(im->controller, &msg)) {
         LOGW("Could not request 'set screen power mode'");
+    } else {
+        im->display_power_on = on;
     }
 }
 
@@ -447,6 +482,61 @@ sc_input_manager_process_key(struct sc_input_manager *im,
         }
     }
 
+    // Finish selection on PC Ctrl release (Android Alt release). Tab releases
+    // may arrive later, so keep swallowing the matching Tab keyup below.
+    if (!down && (sdl_keycode == SDLK_LCTRL || sdl_keycode == SDLK_RCTRL)
+            && !(mod & SDL_KMOD_CTRL)) {
+        release_recent_apps_alt(im);
+    }
+
+    // PC Ctrl+Tab sends Android Alt+Tab; Shift reverses the direction.
+    // Android keeps its recent-apps chooser open until Alt is released.
+    if (sdl_keycode == SDLK_TAB) {
+        if (down && ctrl &&
+                !(mod & (SDL_KMOD_ALT | SDL_KMOD_GUI))) {
+            if (!repeat && !im->ctrl_tab_down && im->kp && !paused
+                    && !disconnected && !im->camera) {
+                const uint32_t alt = AMETA_ALT_ON | AMETA_ALT_LEFT_ON;
+                if (!im->android_alt_down) {
+                    im->android_alt_down = send_recent_apps_key(im,
+                            AKEYCODE_ALT_LEFT, SC_ACTION_DOWN, alt);
+                }
+                if (im->android_alt_down) {
+                    uint32_t meta = alt | (shift ? AMETA_SHIFT_ON : 0);
+                    send_recent_apps_key(im, AKEYCODE_TAB, SC_ACTION_DOWN,
+                                         meta);
+                    send_recent_apps_key(im, AKEYCODE_TAB, SC_ACTION_UP,
+                                         meta);
+                }
+            }
+            im->ctrl_tab_down = true;
+            return;
+        }
+        if (!down && im->ctrl_tab_down) {
+            im->ctrl_tab_down = false;
+            return;
+        }
+    }
+
+    // While Android's recent-apps chooser is open, Ctrl+W dismisses the
+    // highlighted task. Forward Android Delete, which the chooser handles.
+    if (sdl_keycode == SDLK_W) {
+        if (down && ctrl && im->android_alt_down && !shift &&
+                !(mod & (SDL_KMOD_ALT | SDL_KMOD_GUI))) {
+            if (!repeat && !im->ctrl_w_down && !paused && !disconnected) {
+                const uint32_t alt = AMETA_ALT_ON | AMETA_ALT_LEFT_ON;
+                send_recent_apps_key(im, AKEYCODE_DEL, SC_ACTION_DOWN, alt);
+                send_recent_apps_key(im, AKEYCODE_DEL, SC_ACTION_UP, alt);
+            }
+            im->ctrl_w_down = true;
+            return;
+        }
+        if (!down && im->ctrl_w_down) {
+            im->ctrl_w_down = false;
+            return;
+        }
+    }
+
     // Shortcuts that do not involve the MOD key
     switch (sdl_keycode) {
         case SDLK_F11:
@@ -582,7 +672,7 @@ sc_input_manager_process_key(struct sc_input_manager *im,
                     return;
-                case SDLK_O:
+                case SDLK_A:
                     if (control && !repeat && down && !paused) {
-                        bool on = shift;
+                        bool on = shift || !im->display_power_on;
                         set_display_power(im, on);
                     }
                     return;
@@ -1169,6 +1259,9 @@ void
 sc_input_manager_handle_event(struct sc_input_manager *im,
                               const SDL_Event *event) {
     switch (event->type) {
+        case SDL_EVENT_WINDOW_FOCUS_LOST:
+            release_recent_apps_alt(im);
+            break;
         case SDL_EVENT_TEXT_INPUT:
             sc_input_manager_process_text_input(im, &event->text);
             break;
